# Auto detect text files and perform LF normalization
* text=auto

# Files that should always have LF line endings
*.sh text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.cmd text eol=lf

# Maven wrapper files (mvnw is a shell script)
mvnw text eol=lf
mvnw.cmd text eol=lf

# Specific files mentioned in warnings
robots.txt text eol=lf

# Binary files - should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
*.class binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.exe binary
*.dll binary